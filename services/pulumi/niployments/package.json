{
    "name": "@niaefeup/niployments-pulumi",
    "main": "bin/index.js",
    "type": "module",
    "private": true,
    "scripts": {
        "lint": "oxlint --type-aware --max-warnings=0",
        "lint:fix": "oxlint --type-aware --fix",
        "format": "oxfmt --check",
        "format:fix": "oxfmt",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "tsc && node --test \"bin/tests/*.test.js\"",
        "check": "pnpm run lint && pnpm run format"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@pulumi/crds": "workspace:*",
        "@pulumi/kubernetes": "^4.34.2",
        "@pulumi/pulumi": "^3.273.0"
    },
    "imports": {
        "#config": "./bin/config.js",
        "#components/*": "./bin/components/*",
        "#platform/*": "./bin/platform/*",
        "#databases/*": "./bin/databases/*",
        "#apps/*": "./bin/apps/*",
        "#dev/*": "./bin/dev/*",
        "#utils/*": "./bin/utils/*"
    },
    "packageManager": "pnpm@12.9.0"
}
